<style>
  #sc { display:flex; flex-direction:column; align-items:center; padding:1rem 0; }
  #gc { cursor:grab; display:block; touch-action:none; }
  #gc:active { cursor:grabbing; }
  #ib { font-size:13px; color:var(--color-text-secondary); margin-top:8px; font-family:var(--font-mono); }
  #legend { display:flex; flex-wrap:wrap; gap:8px 14px; margin-top:12px; padding:10px 14px; background:var(--color-background-primary); border:0.5px solid var(--color-border-tertiary); border-radius:var(--border-radius-md); max-width:620px; width:100%; box-sizing:border-box; }
  .li { display:flex; align-items:center; gap:5px; font-size:12px; color:var(--color-text-secondary); }
  .ls { width:12px; height:12px; border-radius:2px; flex-shrink:0; }
</style>

<div id="sc">
  <h2 class="sr-only">Interactive stereographic Earth projection colored by biome type. Drag to rotate the pole.</h2>
  <canvas id="gc" width="620" height="560"></canvas>
  <div id="ib">pole: <span id="pc">lat 90.0° N, lon 0.0°</span></div>
  <div id="legend"></div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/topojson/3.0.2/topojson.min.js"></script>
<script>
(function(){
  const BIOMES = {
    tropical_rainforest: { label: 'Tropical rainforest', color: '#2d6a1f', dark: '#4a9a33' },
    temperate_forest:    { label: 'Temperate forest',    color: '#5a8a3a', dark: '#7ab855' },
    boreal_forest:       { label: 'Boreal forest (taiga)', color: '#4a7060', dark: '#6a9a80' },
    grassland:           { label: 'Grassland / savanna', color: '#b8a44a', dark: '#d4be6a' },
    desert:              { label: 'Desert',              color: '#d4b483', dark: '#c8a86e' },
    mediterranean:       { label: 'Mediterranean scrub', color: '#8a9a40', dark: '#a8ba5a' },
    tundra:              { label: 'Tundra',              color: '#8aa0a8', dark: '#a8bec8' },
    ice:                 { label: 'Ice / polar',         color: '#ddeef8', dark: '#c8e0f0' },
    wetland:             { label: 'Wetland / mangrove',  color: '#3a7060', dark: '#5a9880' },
    montane:             { label: 'Montane / highland',  color: '#9a8070', dark: '#b89888' },
    ocean:               { label: 'Ocean',               color: '#b8d4e8', dark: '#1a3a5a' },
  };

  const COUNTRY_BIOME = {
    4:'montane',8:'mediterranean',12:'desert',24:'tropical_rainforest',32:'grassland',
    36:'temperate_forest',50:'tropical_rainforest',56:'temperate_forest',64:'montane',
    68:'grassland',76:'tropical_rainforest',100:'temperate_forest',104:'tropical_rainforest',
    116:'tropical_rainforest',120:'tropical_rainforest',124:'boreal_forest',
    140:'tropical_rainforest',144:'tropical_rainforest',152:'desert',156:'temperate_forest',
    170:'tropical_rainforest',180:'tropical_rainforest',188:'tropical_rainforest',
    191:'temperate_forest',192:'tropical_rainforest',196:'mediterranean',204:'tropical_rainforest',
    208:'temperate_forest',214:'tropical_rainforest',218:'tropical_rainforest',
    818:'desert',222:'tropical_rainforest',231:'tropical_rainforest',246:'boreal_forest',
    250:'temperate_forest',266:'tropical_rainforest',276:'temperate_forest',
    288:'tropical_rainforest',320:'tropical_rainforest',324:'tropical_rainforest',
    328:'tropical_rainforest',332:'tropical_rainforest',340:'tropical_rainforest',
    356:'tropical_rainforest',360:'tropical_rainforest',368:'desert',364:'desert',
    372:'temperate_forest',376:'mediterranean',380:'mediterranean',384:'tropical_rainforest',
    388:'tropical_rainforest',392:'temperate_forest',400:'desert',404:'grassland',
    410:'temperate_forest',408:'boreal_forest',418:'tropical_rainforest',422:'mediterranean',
    426:'grassland',430:'tropical_rainforest',434:'desert',144:'tropical_rainforest',
    454:'tropical_rainforest',458:'tropical_rainforest',466:'desert',484:'desert',
    504:'desert',508:'tropical_rainforest',516:'desert',524:'montane',
    528:'temperate_forest',540:'tropical_rainforest',558:'tropical_rainforest',
    562:'desert',566:'tropical_rainforest',578:'boreal_forest',586:'desert',
    600:'tropical_rainforest',604:'desert',608:'tropical_rainforest',
    616:'temperate_forest',620:'mediterranean',630:'tropical_rainforest',
    634:'desert',642:'temperate_forest',643:'boreal_forest',646:'tropical_rainforest',
    682:'desert',686:'desert',694:'tropical_rainforest',706:'desert',
    710:'grassland',724:'mediterranean',728:'grassland',729:'desert',
    752:'boreal_forest',756:'montane',760:'desert',762:'montane',
    764:'tropical_rainforest',768:'tropical_rainforest',780:'tropical_rainforest',
    788:'desert',792:'mediterranean',800:'tropical_rainforest',804:'temperate_forest',
    784:'desert',826:'temperate_forest',840:'temperate_forest',
    858:'grassland',860:'desert',862:'tropical_rainforest',704:'tropical_rainforest',
    887:'desert',894:'tropical_rainforest',716:'grassland',
    10:'ice',304:'tundra',
  };

  function getColor(id, dark) {
    const b = COUNTRY_BIOME[+id] || 'grassland';
    return dark ? BIOMES[b].dark : BIOMES[b].color;
  }

  const canvas = document.getElementById('gc');
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const cx = W/2, cy = H/2;
  let poleLat = 90, poleLon = 0, scale = 220;
  let isDragging = false, lastX = 0, lastY = 0;
  let geoData = null, geoGraticule = null, features = [];

  const isDark = () => window.matchMedia('(prefers-color-scheme: dark)').matches;

  const proj = () => d3.geoStereographic()
    .rotate([-poleLon, -poleLat])
    .scale(scale)
    .translate([cx, cy])
    .clipAngle(160);

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const p = proj();
    const path = d3.geoPath(p, ctx);
    const dark = isDark();

    ctx.save();
    ctx.beginPath(); path({type:'Sphere'});
    ctx.fillStyle = dark ? '#0a1a2e' : '#c5ddef';
    ctx.fill();
    ctx.restore();

    if (geoGraticule) {
      ctx.save();
      ctx.beginPath(); path(geoGraticule);
      ctx.strokeStyle = dark ? 'rgba(80,130,200,0.12)' : 'rgba(60,110,180,0.15)';
      ctx.lineWidth = 0.4;
      ctx.stroke();
      ctx.restore();
    }

    features.forEach(f => {
      ctx.save();
      ctx.beginPath(); path(f);
      ctx.fillStyle = getColor(f.id, dark);
      ctx.strokeStyle = dark ? 'rgba(0,0,0,0.4)' : 'rgba(255,255,255,0.5)';
      ctx.lineWidth = 0.3;
      ctx.fill();
      ctx.stroke();
      ctx.restore();
    });

    ctx.save();
    ctx.beginPath(); path({type:'Sphere'});
    ctx.strokeStyle = dark ? '#2a5070' : '#5a90b8';
    ctx.lineWidth = 1.2;
    ctx.stroke();
    ctx.restore();

    const ps = p([poleLon, poleLat]);
    if (ps) {
      ctx.save();
      ctx.beginPath(); ctx.arc(ps[0], ps[1], 5, 0, Math.PI*2);
      ctx.fillStyle = '#e04030';
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.5;
      ctx.stroke();
      ctx.restore();
    }
  }

  function updateLabel() {
    const la = Math.abs(poleLat).toFixed(1), ld = poleLat >= 0 ? 'N' : 'S';
    const ln = ((poleLon % 360) + 360) % 360;
    const ls = ln > 180 ? (360-ln).toFixed(1)+'° W' : ln.toFixed(1)+'° E';
    document.getElementById('pc').textContent = `lat ${la}° ${ld}, lon ${ls}`;
  }

  function buildLegend() {
    const lg = document.getElementById('legend');
    const usedBiomes = new Set(Object.values(COUNTRY_BIOME));
    usedBiomes.add('ocean');
    const dark = isDark();
    lg.innerHTML = [...usedBiomes].map(k => {
      const b = BIOMES[k];
      return `<span class="li"><span class="ls" style="background:${dark ? b.dark : b.color};border:0.5px solid rgba(0,0,0,0.15)"></span>${b.label}</span>`;
    }).join('');
  }

  canvas.addEventListener('mousedown', e => { isDragging=true; lastX=e.offsetX; lastY=e.offsetY; });
  canvas.addEventListener('mousemove', e => {
    if (!isDragging) return;
    const dx=e.offsetX-lastX, dy=e.offsetY-lastY;
    lastX=e.offsetX; lastY=e.offsetY;
    poleLon += dx*0.35;
    poleLat = Math.max(-89.9, Math.min(89.9, poleLat - dy*0.35));
    updateLabel(); draw();
  });
  canvas.addEventListener('mouseup', () => isDragging=false);
  canvas.addEventListener('mouseleave', () => isDragging=false);
  canvas.addEventListener('wheel', e => {
    e.preventDefault();
    scale = Math.max(80, Math.min(900, scale * (e.deltaY > 0 ? 0.9 : 1.1)));
    draw();
  }, {passive:false});
  canvas.addEventListener('touchstart', e => {
    e.preventDefault();
    if (e.touches.length===1) { isDragging=true; lastX=e.touches[0].clientX; lastY=e.touches[0].clientY; }
  },{passive:false});
  canvas.addEventListener('touchmove', e => {
    e.preventDefault();
    if (!isDragging||e.touches.length!==1) return;
    const dx=e.touches[0].clientX-lastX, dy=e.touches[0].clientY-lastY;
    lastX=e.touches[0].clientX; lastY=e.touches[0].clientY;
    poleLon += dx*0.35;
    poleLat = Math.max(-89.9, Math.min(89.9, poleLat - dy*0.35));
    updateLabel(); draw();
  },{passive:false});
  canvas.addEventListener('touchend', () => isDragging=false);

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { buildLegend(); draw(); });

  async function load() {
    const world = await d3.json('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json');
    const fc = topojson.feature(world, world.objects.countries);
    features = fc.features;
    geoGraticule = d3.geoGraticule()();
    buildLegend();
    draw();
  }

  draw();
  updateLabel();
  load();
})();
</script>
